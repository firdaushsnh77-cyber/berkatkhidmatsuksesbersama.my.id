<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<style>
  body { font-family: Arial, sans-serif; background: #fff; padding: 20px; }
  .month-container { max-width: 800px; margin: 0 auto 50px auto; border: 2px solid #000; padding: 15px; }
  .header { display: flex; justify-content: space-between; align-items: center; font-size: 32px; font-weight: bold; margin-bottom: 10px; }
  table { width: 100%; border-collapse: collapse; }
  th, td { border: 2px solid #000; width: 14.28%; height: 70px; text-align: center; vertical-align: middle; font-size: 22px; font-weight: bold; }
  th { height: 35px; font-size: 14px; text-transform: uppercase; }
  th.sun, td.sun { color: #d9534f; }
  th.sat, td.sat { color: #0275d8; }
  td.holiday { color: #d9534f; }
  .note { font-size: 14px; font-weight: normal; margin-top: 10px; }
</style>
</head>
<body>

<!-- OKTOBER -->
<div class="month-container">
  <div class="header"><span>10</span> <span>OCTOBER 2026</span></div>
  <table>
    <tr><th class="sun">SUNDAY</th><th>MONDAY</th><th>TUESDAY</th><th>WEDNESDAY</th><th>THURSDAY</th><th>FRIDAY</th><th class="sat">SATURDAY</th></tr>
